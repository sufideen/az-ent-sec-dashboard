// ============================================================================
// Query: Key Vault Security Findings
// Purpose: Unhealthy Defender for Key Vault recommendations (firewall,
// diagnostics, purge protection), for the SOC dashboard.
// Table: SecurityRecommendation
// Parameters (workbook-bound): {TimeRange}
// ============================================================================
SecurityRecommendation
| where TimeGenerated {TimeRange}
| summarize arg_max(TimeGenerated, *) by RecommendationName, AssessedResourceId
| where RecommendationState =~ 'Unhealthy'
| where AssessedResourceId has '/providers/microsoft.keyvault/vaults/'
| project
    TimeGenerated,
    KeyVaultResourceId = AssessedResourceId,
    KeyVaultName = extract(@'vaults/([^/]+)', 1, AssessedResourceId),
    RecommendationDisplayName,
    RecommendationSeverity,
    RemediationDescription
| sort by RecommendationSeverity asc
